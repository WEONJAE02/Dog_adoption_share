# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# 키를 이슈, PR, 메신저에 붙여 넣지 마세요.

# DB (README의 Docker MySQL 기준)
DB_USERNAME=root
DB_PASSWORD=

# 선택: 다른 DB를 쓸 때만
# DB_URL=jdbc:mysql://localhost:3307/petdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=utf8
# UPLOAD_DIR=uploads
# FRONTEND_URL=http://localhost:5500/index.html

# 소셜 로그인 (비워 두면 이메일 로그인만 동작)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 구조동물 조회 서비스 (비워 두면 "전국 보호소 유기견" 영역만 안내 문구 표시)
ANIMAL_API_KEY=

# 건강체크 AI 분석 (비워 두면 샘플 결과만 나오고 비용이 들지 않습니다)
# console.anthropic.com 에서 발급. 콘솔에서 월 사용 한도를 꼭 걸어 두세요.
ANTHROPIC_API_KEY=
# HEALTH_AI_MODEL=claude-opus-5-5
# HEALTH_DAILY_LIMIT=10
